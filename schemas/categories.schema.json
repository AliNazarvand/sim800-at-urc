{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SIM800 categories.yaml",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "label", "manual_chapter"],
    "additionalProperties": false,
    "properties": {
      "id":             { "type": "string", "pattern": "^[A-Za-z0-9_]+$" },
      "label":          { "type": "string", "minLength": 1 },
      "manual_chapter": { "type": "integer", "minimum": 1 }
    }
  }
}